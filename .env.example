NODE_ENV=development
HTTP_PORT=3000
HOST_NAME=localhost

# MongoDB
MONGO_URI=mongodb://localhost:27017/portfolio
# For Atlas: MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio

# CORS — set to your frontend origin in production (e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Admin dashboard auth — CHANGE THESE before deploying (never commit real values)
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# Optional: absolute path to the resume PDF (defaults to ./resume/Vikas_Kannaujiya_Resume.pdf)
# RESUME_PATH=
