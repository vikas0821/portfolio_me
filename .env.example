# ── Unified platform (.env) ─────────────────────────────────────────────────
# Copy to .env. docker-compose.yml auto-loads it. Never commit real secrets.

# Auth — one secret signs all per-section JWTs; one password per gate.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ADMIN_PASSWORD=admin123
NOTES_PASSWORD=notes123
RESUME_PASSWORD=resume123
OPTION_PASSWORD=option123

# CORS — set to your frontend origin in production (e.g. https://your-app.vercel.app)
CORS_ORIGINS=*

# Host ports (override if they clash locally)
WEB_HOST_PORT=8080
API_HOST_PORT=8002
PG_HOST_PORT=5433

# Resume → email send (optional; leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Job Application

# ── Production only ─────────────────────────────────────────────────────────
# Backend (Render) — point at a managed Postgres (Neon/Supabase):
#   DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST/DB?sslmode=require
# Frontend (Vercel) build-time — point at the deployed backend:
#   VITE_API_URL=https://<backend>.onrender.com/api/v1/
#   VITE_OPTION_API_URL=https://<backend>.onrender.com/api/v1/option
#   VITE_RESUME_API_URL=https://<backend>.onrender.com
